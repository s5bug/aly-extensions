{
  "name": "aly-extensions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm run check && node build.ts",
    "dev": "node build.ts --watch",
    "clean": "node build.ts --clean",
    "repo": "node repo.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@electron/asar": "^4.2.1",
    "@moonlight-mod/esbuild-config": "^1.1.0",
    "@moonlight-mod/eslint-config": "github:moonlight-mod/eslint-config",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@moonlight-mod/types": "^2026.7.0",
    "katex": "^0.18.4"
  }
}
